# =============================================================================
# Viral Video Factory — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Core ---
VVF_ENV=development            # development | production
VVF_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
VVF_SECRET_KEY=change-me-to-a-long-random-string

# --- Admin (single-admin MVP) ---
VVF_ADMIN_USERNAME=admin
VVF_ADMIN_PASSWORD=changeme

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vvf
POSTGRES_USER=vvf
POSTGRES_PASSWORD=vvf_dev_password

# --- Redis (queue + task state) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed dashboard origins for CORS
VVF_CORS_ORIGINS=http://localhost:3000

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- wigolo integration (discovery search) ---
# wigolo runs as a protected local service (`wigolo serve` REST API).
# Enable the live daemon: VVF_WIGOLO_USE_MOCK=0 + `--profile wigolo` on compose.
VVF_WIGOLO_USE_MOCK=1                       # 1 = deterministic mock data, 0 = live wigolo
VVF_WIGOLO_BASE_URL=http://wigolo:3333
# Required when wigolo binds off loopback (as it does in Docker). Generate with:
#   openssl rand -hex 32
WIGOLO_API_TOKEN=
# The worker reads the token from VVF_WIGOLO_API_TOKEN; compose maps it from
# WIGOLO_API_TOKEN so the value is defined once.
VVF_WIGOLO_API_TOKEN=
# Search tuning: news category keeps date handling date-aware; time_range keeps
# stale articles out of the candidate pool.
VVF_WIGOLO_CATEGORY=news                    # general | news | code | docs | papers | images
VVF_WIGOLO_TIME_RANGE=week                  # day | week | month | year (empty = no filter)
VVF_WIGOLO_SEARCH_DEPTH=balanced            # ultra-fast | fast | balanced | deep

# --- MoneyPrinterTurbo integration (reached from the local PC) ---
MPT_BASE_URL=http://127.0.0.1:8080
MPT_API_TOKEN=

# --- Local render PC preview server (Tailscale only; never 0.0.0.0) ---
# Set on the PC. VVF_PREVIEW_HOST must be the machine's Tailscale IP/interface
# so the VPS can proxy the video stream (the file is never uploaded/stored on VPS).
VVF_PREVIEW_HOST=127.0.0.1          # set to the PC's Tailscale IP (e.g. 100.x.y.z)
VVF_PREVIEW_PORT=8090
VVF_PREVIEW_ROOT=MoneyPrinterTurbo/storage/tasks
# VVF_PREVIEW_BASE_URL=             # optional explicit override, e.g. http://100.x.y.z:8090

# --- Publishing credentials (M6) — set on the RENDER PC only, never on the VPS ---
# Publishing runs where the video lives. These are read by the local agent's
# publisher processes and are never sent to or stored on the VPS.
# Any platform left unset is reported as `manual_required` (upload by hand and
# record the post URL in the dashboard). See docs/publishing-setup.md.

# YouTube Shorts — YouTube Data API v3 (OAuth refresh token, scope youtube.upload)
VVF_YOUTUBE_CLIENT_ID=
VVF_YOUTUBE_CLIENT_SECRET=
VVF_YOUTUBE_REFRESH_TOKEN=
VVF_YOUTUBE_CATEGORY_ID=25          # 25 = News & Politics

# TikTok — Content Posting API, Direct Post (scope video.publish)
VVF_TIKTOK_ACCESS_TOKEN=
VVF_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE   # auto-downgraded if not allowed

# Instagram Reels — Graph API. Local-file upload needs Facebook Login for
# Business (rupload.facebook.com); Instagram-Login apps require a public URL and
# will fall back to manual.
VVF_INSTAGRAM_ACCESS_TOKEN=
VVF_INSTAGRAM_USER_ID=
VVF_INSTAGRAM_API_VERSION=v24.0
VVF_INSTAGRAM_SHARE_TO_FEED=1

# --- LLM provider (for candidate scoring/script generation) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
