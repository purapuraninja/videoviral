# Multi-stage production build for the VVF dashboard (Next.js standalone).
FROM node:20-alpine AS deps
WORKDIR /app
COPY apps/dashboard/package*.json ./
RUN npm install

FROM deps AS builder
WORKDIR /app
# NEXT_PUBLIC_* is inlined at BUILD time, so the rewrite destination must be
# known during `next build`. http://api:8000 resolves on the compose network
# at request time (the dashboard server proxies, not the browser).
ARG NEXT_PUBLIC_API_URL=http://api:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY apps/dashboard/ .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/package.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.js ./
COPY --from=deps /app/node_modules ./node_modules
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
